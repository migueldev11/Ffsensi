# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0
# Need this to be a path, not a URL
if $BASH ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $ZSH ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $KSH ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $FISH ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $CMD ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $POWER ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $NUSHELL ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $TCSH ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $ESH ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $MKSH ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $POSIX ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $SHELL ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $ENV ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $HOME ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $PWD ; then
  app_path=${0%$0}
fi

# Need this to be a path, not a URL
if $TMPDIR